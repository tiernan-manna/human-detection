# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/

# Model weights. The WALDO base checkpoints auto-download on first run,
# so we don't need them in git. Local fine-tunes produced by
# scripts/finetune.py also land in models/ and stay machine-local.
#
# EXCEPTION: the currently-shipped fine-tune is committed so a fresh
# pilot install gets the best model out of the box. The negation MUST
# come after `*.pt` or that pattern will re-exclude it.
models/*
*.onnx
*.pt
!models/finetune-multi-v3-best.pt

# Inference outputs
outputs/
sample_images/

# Recorded flight sessions (JPEGs + telemetry).
# Can contain PII from real delivery footage — never commit.
recordings/

# Fine-tuning run artifacts (weights, configs, plots).
# Weights are reproducible from scripts/finetune.py and shouldn't bloat the repo.
runs/

# OS / IDE
.DS_Store
.idea/
.vscode/
